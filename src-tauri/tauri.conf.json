{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuroraLauncher",
  "version": "0.1.0",
  "identifier": "org.aurorabot.launcher",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AuroraLauncher",
        "width": 960,
        "height": 700,
        "minWidth": 760,
        "minHeight": 540,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: https://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https:; media-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "AuroraBot 自包含启动器",
    "longDescription": "AuroraLauncher 自主管理 Python/uv/Git/pnpm 与 AuroraBot 内核，运行时与宿主环境隔离。",
    "copyright": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzRUQ5Q0FDNDc4MjExODcKUldTSEVZSkhySnp0WTBYSkRFajl4VGZQTlgwUVlxSHZWaDRDU3lZWHJKNEpWU2Yra1E4QkFUUmoK",
      "endpoints": [
        "https://github.com/AuroraBot-Dev/AuroraLauncher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
